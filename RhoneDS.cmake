function (BuildRhoneDS BINARY_NAME)
        if (RHONELIB_DIR)
                message(STATUS "Using RhoneLib from ${RHONELIB_DIR}")
                include("${RHONELIB_DIR}/cmake/RhoneClient.cmake")
                RHONE_SET_COMMON_COMPILER_OPTIONS()
                add_executable(${BINARY_NAME} ${SOURCE_FILES_APP} ${SOURCE_FILES_LIB} ${PROTO})
                target_include_directories(${BINARY_NAME} PUBLIC ${RHONELIB_DIR}/include)
                target_link_libraries(${BINARY_NAME} "-Wl,--whole-archive \"${RHONELIB_DIR}/${RELEASE}/libgtRhoneLib.a\" -Wl,--no-whole-archive")
                #target_link_libraries(${BINARY_NAME} "-Wl,--whole-archive -fsanitize=address \"${RHONELIB_DIR}/${RELEASE}/libgtRhoneLib.a\" -Wl,--no-whole-archive -fsanitize=address")
                set_target_properties(${BINARY_NAME} PROPERTIES LINK_FLAGS "-L/usr/local/lib -Wl,-rpath,/usr/local/lib")
                target_link_libraries(${BINARY_NAME} "/usr/lib64/libtdsodbc.so.0")
                target_link_libraries(${BINARY_NAME} z rt pthread log4cxx numa config++ boost_filesystem boost_system onload_ext ciul1 dl protobuf curl sybdb lz4)
                if (CMAKE_BUILD_TYPE MATCHES Debug)
                        SET(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKGER_FLAGS} -fuse-ld=gold")
                        target_link_libraries(${BINARY_NAME} /usr/lib64/libcryptopp.a)
                endif()
        else()
                message(STATUS "Using RhonePublic sources for compile")
                include(${RHONEPUBLIC_DIR}/cmake/RhoneCoreBuildSettings.cmake)
                RHONE_SET_COMMON_COMPILER_OPTIONS()
                include(${RHONEDS_DIR}/RhoneDsLib.cmake)
                CreateRhoneDsLibTarget()
                include(${RHONEDS_DIR}/RhoneDsExe.cmake)
                CreateRhoneDsExeTarget(${BINARY_NAME})
                SET(RHONELIB_DIR ${RHONEPUBLIC_DIR})
        endif()

        if(EXISTS ${RHONELIB_DIR}/rhone.q)
                ADD_CUSTOM_COMMAND(TARGET ${BINARY_NAME} POST_BUILD
                        COMMAND cp ${RHONELIB_DIR}/rhone.q ${CMAKE_RUNTIME_OUTPUT_DIRECTORY})
        endif()
endfunction()

